#include <winver.h>

IDI_ICON1 ICON "nexa-assistant.ico"

#ifdef NEXA_VERSION_MAJOR
#define VER_FILEVERSION             NEXA_VERSION_MAJOR,NEXA_VERSION_MINOR,NEXA_VERSION_PATCH,0
#define VER_FILEVERSION_STR         NEXA_VERSION_STR "\0"
#else
#define VER_FILEVERSION             1,0,0,0
#define VER_FILEVERSION_STR         "1.0.0\0"
#endif

1 VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nexa"
            VALUE "FileDescription", "Nexa Assistant"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "nexa-assistant"
            VALUE "OriginalFilename", "nexa-assistant.exe"
            VALUE "ProductName", "Nexa Assistant"
            VALUE "ProductVersion", VER_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
