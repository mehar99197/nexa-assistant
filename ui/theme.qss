/* Nexa's theme. The tokens (a name between at-signs) are filled in by NexaTheme from the palette
   of the scheme (dark or light); this file decides which widget wears which token, so it stays the
   single source of the look. Classes in the nexa namespace are selected as nexa--Class. */

QWidget {
    background: @ground@;
    color: @text@;
    font-family: "@font@";
    font-size: @fontSize@pt;
    selection-background-color: @idle@;
    selection-color: @onAccent@;
}
QLabel { background: transparent; }
QToolTip { background: @panel@; color: @text@; border: 1px solid @line@; padding: 4px 6px; }

/* ---- the main window: toolbar pills, state header, chat, input bar, status bar */

QMainWindow::separator { background: @line@; width: 1px; height: 1px; }

QToolBar#mainToolbar {
    background: @ground@;
    border: 0;
    border-bottom: 1px solid @line@;
    padding: 8px 10px;
    spacing: 8px;
}
QToolBar#mainToolbar::separator { width: 0; }

QFrame#pill { background: @panel@; border: 1px solid @line@; border-radius: @radiusSmall@px; }
QLabel#pillLabel { color: @muted@; padding-left: 4px; }
QLabel#pillValue { color: @text@; font-family: "@mono@"; padding-right: 4px; }

QComboBox#modelCombo {
    background: transparent;
    border: 0;
    padding: 0 2px;
    color: @text@;
    font-family: "@mono@";
    min-height: 24px;
}
QComboBox#modelCombo QLineEdit { background: transparent; border: 0; color: @text@; font-family: "@mono@"; }

QToolButton#iconButton {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: @radiusSmall@px;
    padding: 4px;
    min-width: 26px;
    min-height: 26px;
}
QToolButton#iconButton:hover { background: @panel2@; border-color: @muted@; }
QToolButton#iconButton:pressed, QToolButton#iconButton:checked { background: @accentSoft@; border-color: @idle@; }

QToolButton#pillButton {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: @radiusSmall@px;
    padding: 7px 10px;
    color: @text@;
}
QToolButton#pillButton:hover { border-color: @muted@; }

QPushButton#stopAll {
    background: @errorSoft@;
    color: @error@;
    border: 1px solid @errorLine@;
    border-radius: @radiusSmall@px;
    padding: 7px 12px;
    font-weight: 600;
}
QPushButton#stopAll:hover { background: @errorSoft2@; }
QPushButton#stopAll:pressed { background: @error@; color: @ground@; }

QWidget#stateHeader { background: transparent; border-bottom: 1px solid @line@; }
QWidget#stateHeader > QWidget { background: transparent; }
QWidget#inputBar { background: transparent; }
QLabel#stateTitle { font-size: 22px; font-weight: 700; }
QLabel#stateHint { color: @muted@; }

QPlainTextEdit#input {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: @radius@px;
    padding: 6px 8px;
    color: @text@;
}
QPlainTextEdit#input:focus { border: 1px solid @idle@; }

QToolButton#inputButton {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: @radius@px;
    min-width: 46px;
    min-height: 46px;
}
QToolButton#inputButton:hover { background: @panel2@; border-color: @muted@; }
QToolButton#inputButton:pressed, QToolButton#inputButton:checked { background: @accentSoft@; border-color: @idle@; }

/* the files attached to the request being typed: one chip each, a click takes it off */
QWidget#attachmentStrip { background: transparent; }
QToolButton#attachmentChip {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: 12px;
    padding: 3px 10px;
    color: @text@;
}
QToolButton#attachmentChip:hover { border-color: @error@; color: @error@; }

QPushButton#send {
    background: @idle@;
    color: @onAccent@;
    border: 0;
    border-radius: @radius@px;
    padding: 0 22px;
    font-weight: 600;
    min-height: 48px;
}
QPushButton#send:hover { background: @listen@; }
QPushButton#send[busy="true"] { background: @error@; color: @ground@; }
QPushButton#send[busy="true"]:hover { background: @error@; }

/* the Actions panel: cards, newest first */
QWidget#dockTitle { background: @ground@; border-bottom: 1px solid @line@; border-left: 1px solid @line@; }
QLabel#dockTitleText { font-weight: 700; }
QLabel#dockTitleNote { color: @muted@; font-family: "@mono@"; font-size: 11px; }
QListWidget#actionList { background: @ground@; border: 0; border-left: 1px solid @line@; outline: 0; }
QListWidget#actionList::item { border: 0; }
QListWidget#actionList::item:selected { background: transparent; }
QListWidget#actionList::item:hover { background: @panel@; }
nexa--ActionLogDock {
    qproperty-mutedColor: @muted@;
    qproperty-lineColor: @line@;
    qproperty-accentColor: @idle@;
    qproperty-errorColor: @error@;
    qproperty-chipColor: @panel2@;
    qproperty-voiceChipColor: @accentSoft@;
    qproperty-monoFamily: "@mono@";
}

/* the Phone panel: the phone's screen, live */
nexa--PhonePanel {
    qproperty-mutedColor: @muted@;
    qproperty-lineColor: @line@;
    qproperty-accentColor: @idle@;
    qproperty-errorColor: @error@;
}
QWidget#phoneBody { background: @ground@; border-left: 1px solid @line@; }
QLabel#phoneInfo, QLabel#phoneStatus { color: @muted@; font-family: "@mono@"; font-size: 11px; }
QLabel#phoneStatus[error="true"] { color: @error@; }
QToolButton#phoneButton {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: @radiusSmall@px;
    padding: 5px 10px;
    color: @text@;
}
QToolButton#phoneButton:hover { background: @panel2@; border-color: @muted@; }
QToolButton#phoneButton:checked { background: @accentSoft@; border-color: @idle@; }

QStatusBar { background: @panel@; border-top: 1px solid @line@; color: @muted@; }
QStatusBar::item { border: 0; }
QStatusBar QLabel { color: @muted@; font-family: "@mono@"; font-size: 11px; padding: 0 6px; }
QStatusBar QLabel[error="true"] { color: @error@; }

/* ---- the phone app (android/) and the pages of Settings */

QLabel#brandTitle { font-size: 20px; font-weight: 700; }
QLabel#statusPill {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: @radius@px;
    padding: 5px 12px;
    color: @muted@;
}
QListWidget#messages { background: @ground@; border: 0; outline: 0; }
QListWidget#messages::item { border: 0; padding: 2px; }
QListWidget#messages::item:selected { background: transparent; color: @text@; }
QLineEdit#phoneInput {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: @radius@px;
    padding: 10px 12px;
    min-height: 26px;
}
QLineEdit#phoneInput:focus { border-color: @idle@; }
QToolButton#send {
    background: @idle@;
    border: 0;
    border-radius: @radius@px;
    min-width: 48px;
    min-height: 48px;
}
QToolButton#send:pressed { background: @listen@; }
QToolButton#send[busy="true"] { background: @error@; }
QLabel#talkHint { color: @muted@; }
QPushButton#primary { background: @idle@; color: @onAccent@; border: 0; font-weight: 600; min-height: 48px; }
QPushButton#primary:hover, QPushButton#primary:pressed { background: @listen@; }
QPushButton#primary:disabled { background: @panel2@; color: @muted@; }

/* ---- everything else: dialogs, lists, inputs, menus, scrollbars */

QDialog, QMessageBox, QInputDialog { background: @ground@; }

QTabWidget::pane { border: 1px solid @line@; border-radius: @radiusSmall@px; top: -1px; background: @ground@; }
QTabBar::tab {
    background: @panel@;
    color: @muted@;
    border: 1px solid @line@;
    border-bottom: 0;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: @radiusSmall@px;
    border-top-right-radius: @radiusSmall@px;
}
QTabBar::tab:selected { color: @text@; background: @ground@; }
QTabBar::tab:hover { color: @text@; }

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: @panel@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: @radiusSmall@px;
    padding: 4px 6px;
    selection-background-color: @idle@;
    selection-color: @onAccent@;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: @idle@;
}
QLineEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled { color: @muted@; }
QComboBox::drop-down { border: 0; width: 20px; }
QComboBox::down-arrow { image: url(:/nexa/ui/chevron-down.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: @panel@;
    color: @text@;
    border: 1px solid @line@;
    selection-background-color: @accentSoft@;
    selection-color: @text@;
    outline: 0;
}
QSpinBox::up-button, QSpinBox::down-button { width: 14px; border: 0; background: transparent; }

QPushButton {
    background: @panel@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: @radiusSmall@px;
    padding: 6px 14px;
}
QPushButton:hover { border-color: @muted@; }
QPushButton:pressed { background: @panel2@; }
QPushButton:disabled { color: @muted@; border-color: @line@; }
QPushButton:default { border-color: @accentLine@; }
QToolButton { background: transparent; border: 0; border-radius: @radiusSmall@px; padding: 3px; }
QToolButton:hover { background: @panel2@; }
QToolButton::menu-indicator { image: none; }

QListWidget, QListView, QTreeWidget, QTreeView, QTableView {
    background: @panel@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: @radiusSmall@px;
    outline: 0;
    alternate-background-color: @ground@;
}
QListWidget::item, QTreeView::item { padding: 3px; }
QListWidget::item:selected, QListView::item:selected, QTreeView::item:selected { background: @accentSoft@; color: @text@; }
QListWidget::item:hover, QTreeView::item:hover { background: @panel2@; }
QHeaderView::section { background: @panel@; color: @muted@; border: 0; border-bottom: 1px solid @line@; padding: 4px; }

QGroupBox { border: 1px solid @line@; border-radius: @radiusSmall@px; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: @muted@; }
QCheckBox, QRadioButton { background: transparent; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator, QListView::indicator, QTreeView::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @muted@;
    border-radius: 4px;
    background: @panel@;
}
QRadioButton::indicator { border-radius: @radiusSmall@px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @idle@; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QListView::indicator:checked, QTreeView::indicator:checked {
    background: @idle@;
    border-color: @idle@;
    image: url(:/nexa/ui/check.svg);
}
QRadioButton::indicator:checked { background: @idle@; border: 4px solid @panel@; outline: 1px solid @idle@; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: @line@; background: @ground@; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QSplitter::handle { background: @line@; }
QTextBrowser { background: @panel@; border: 1px solid @line@; border-radius: @radiusSmall@px; }
QProgressBar { background: @panel@; border: 1px solid @line@; border-radius: @radiusSmall@px; text-align: center; color: @text@; }
QProgressBar::chunk { background: @idle@; border-radius: 5px; }

QMenu { background: @panel@; color: @text@; border: 1px solid @line@; padding: 4px; }
QMenu::item { padding: 6px 20px; border-radius: 4px; background: transparent; }
QMenu::item:selected { background: @accentSoft@; }
QMenu::separator { height: 1px; background: @line@; margin: 4px 8px; }
QMenu::icon { padding-left: 6px; }

QSlider::groove:horizontal { height: 4px; background: @line@; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -5px 0; background: @idle@; border-radius: 7px; }
QSlider::sub-page:horizontal { background: @idle@; border-radius: 2px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @line@; border-radius: 4px; min-height: 24px; margin: 2px; }
QScrollBar::handle:vertical:hover { background: @muted@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: transparent; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: @line@; border-radius: 4px; min-width: 24px; margin: 2px; }
QScrollBar::handle:horizontal:hover { background: @muted@; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: transparent; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

nexa--NexaCoreWidget {
    background: transparent;
    qproperty-idleColor: @idle@;
    qproperty-wakeColor: @wake@;
    qproperty-listenColor: @listen@;
    qproperty-sttColor: @stt@;
    qproperty-thinkColor: @think@;
    qproperty-actColor: @act@;
    qproperty-speakColor: @speak@;
    qproperty-fastColor: @fast@;
    qproperty-errorColor: @error@;
    qproperty-panelColor: @panel@;
    qproperty-lineColor: @line@;
    qproperty-mutedColor: @muted@;
    qproperty-textColor: @text@;
    qproperty-groundColor: @ground@;
    qproperty-coreStyle: @coreStyle@;
    qproperty-coreShape: @coreShape@;
}

/* Last, after the generic rules of the same specificity: the transcript keeps the window's ground. */
nexa--ChatView {
    background: @ground@;
    border: 0;
    font-family: "@chatFont@";
    qproperty-bubbleStyle: @bubbleStyle@;
    qproperty-bubbleRadius: @radius@;
    qproperty-userBubbleColor: @panel@;
    qproperty-metaColor: @muted@;
    qproperty-accentColor: @idle@;
    qproperty-errorColor: @error@;
    qproperty-codeColor: @panel@;
    qproperty-monoFamily: "@mono@";
}

/* ---- Settings → Providers: the sign-in block and the provider gallery. The tones are tokens every palette has
   (wake = green, act = amber, error = red); the words say the same, so the colour is never alone. */
nexa--ProviderSignInBlock {
    background: transparent;
    qproperty-goodColor: @wake@;
    qproperty-warnColor: @act@;
    qproperty-badColor: @error@;
    qproperty-mutedColor: @muted@;
}
QLineEdit#signInLink { font-family: "@mono@"; font-size: 11px; }
QPushButton#galleryChip { padding: 4px 12px; border-radius: 13px; color: @muted@; }
QPushButton#galleryChip:hover { color: @text@; border-color: @muted@; }
QPushButton#galleryChip:checked { background: @accentSoft@; border-color: @accentLine@; color: @text@; }
QLabel#galleryCount { color: @muted@; }
QListWidget#galleryList::item { padding: 0; }

/* ---- the theme's chrome: the window's ground wears the backdrop (a grid, dots, a glow, a horizon, scan lines —
   or nothing), and a panel wears the chrome. In the Flat chrome the sheet draws the panel itself (panelFill is the
   panel's colour, panelBorder a hairline); in any other the panel paints its own fill and frame in these colours,
   and the sheet leaves it bare (panelFill transparent, panelBorder 0). */
nexa--BackdropWidget {
    qproperty-backdrop: @backdrop@;
    qproperty-groundColor: @ground@;
    qproperty-lineColor: @line@;
    qproperty-accentColor: @idle@;
}
nexa--ChromeFrame {
    qproperty-panelChrome: @panelChrome@;
    qproperty-cornerRadius: @radius@;
    qproperty-groundColor: @ground@;
    qproperty-panelColor: @panel@;
    qproperty-lineColor: @line@;
    qproperty-accentColor: @idle@;
    qproperty-textColor: @text@;
}

/* ---- designs: cards and tiles (Dashboard), the state in the status line (Console) */
QFrame#tile { background: @panelFill@; border: @panelBorder@; border-radius: @radius@px; }
QFrame#tile > QWidget { background: transparent; }
QWidget#stateHeader[tile="true"] { border: 0; }
nexa--ChatView[tile="true"] { background: @panelFill@; }
QLabel#statusState { color: @text@; font-weight: 700; }
QLabel#orbTitle { font-size: 30px; font-weight: 700; }

/* ---- Mission Control: the agents rail, the core card, the board, the live activity. Lanes and states wear tokens every
   palette has (stt = web, think = code, wake = screen and "online", listen = phone, speak = voice, act = what needs the
   user, error = a failure), and every chip says its state in words too. */
nexa--MissionPanel {
    background: @panelFill@;
    border: @panelBorder@;
    border-radius: @radius@px;
    qproperty-mutedColor: @muted@;
    qproperty-raisedColor: @panel2@;
    qproperty-goodColor: @wake@;
    qproperty-warnColor: @act@;
    qproperty-errorColor: @error@;
    qproperty-webColor: @stt@;
    qproperty-codeColor: @think@;
    qproperty-screenColor: @wake@;
    qproperty-phoneColor: @listen@;
    qproperty-voiceColor: @speak@;
    qproperty-monoFamily: "@mono@";
}
nexa--TaskStrip { background: transparent; border: 0; border-bottom: 1px solid @line@; border-radius: 0; qproperty-panelChrome: 0; }
QStackedWidget#missionCentre { background: transparent; }
QLabel#sectionTitle { color: @muted@; font-family: "@mono@"; font-size: 11px; font-weight: 700; background: transparent; }
QLabel#sectionNote, QLabel#boardCounts { color: @muted@; font-family: "@mono@"; font-size: 11px; background: transparent; }
QListView#agentList, QListView#taskList, QListView#queueList, QListView#activityList, QListView#taskStrip {
    background: transparent; border: 0; outline: 0;
}
QFrame#voiceCard { background: @panel2@; border: 1px solid @line@; border-radius: @radiusSmall@px; }
QLabel#voiceName { color: @speak@; font-family: "@mono@"; font-weight: 700; background: transparent; }
QLabel#voiceChip {
    color: @speak@; font-family: "@mono@"; font-size: 10px; font-weight: 700;
    border: 1px solid @speak@; border-radius: 4px; padding: 1px 6px; background: transparent;
}
QLabel#voiceLine { color: @text@; background: transparent; }
nexa--SparklineWidget { background: transparent; qproperty-lineColor: @idle@; }
nexa--SparklineWidget#voiceLevel { qproperty-lineColor: @speak@; }
QPushButton#spawn { background: transparent; border: 1px dashed @line@; color: @muted@; padding: 10px; }
QPushButton#spawn:hover { color: @text@; border-color: @muted@; }
QPushButton#ghost { background: transparent; border: 1px solid @line@; color: @text@; padding: 6px 14px; }
QPushButton#ghost:hover { border-color: @muted@; }
QPushButton#ghost:disabled { color: @muted@; }
QPushButton#addTasksButton { background: @idle@; color: @onAccent@; border: 0; padding: 7px 16px; font-weight: 600; }
QLabel#coreTitle { font-size: 22px; font-weight: 700; color: @idle@; background: transparent; }
QLabel#micLine { color: @wake@; font-family: "@mono@"; font-size: 11px; background: transparent; }
QLabel#micLine[trouble="true"] { color: @act@; }
QLabel#lastHeard { color: @muted@; font-family: "@mono@"; font-size: 11px; background: transparent; }
QFrame#metricTile { background: @panel2@; border: 1px solid @line@; border-radius: @radiusSmall@px; }
QLabel#tileLabel { color: @muted@; font-family: "@mono@"; font-size: 10px; background: transparent; }
QLabel#tileValue { color: @text@; font-family: "@mono@"; font-size: 18px; font-weight: 700; background: transparent; }
QLabel#tileValue[tone="web"] { color: @stt@; }
QLabel#tileValue[tone="code"] { color: @think@; }
QLabel#tileValue[tone="screen"] { color: @wake@; }
QLabel#streaming { color: @wake@; font-family: "@mono@"; font-size: 10px; background: transparent; }
QPushButton#laneChip {
    padding: 5px 8px; border-radius: @radiusSmall@px; color: @muted@; font-family: "@mono@"; font-size: 10px;
    background: @panel2@; border: 1px solid @line@;
}
QPushButton#laneChip:checked { background: @idle@; color: @onAccent@; border-color: @idle@; }
QFrame#approvalCard { background: @panel2@; border: 1px solid @act@; border-radius: @radiusSmall@px; }
QLabel#approvalTitle { color: @act@; font-family: "@mono@"; font-size: 11px; font-weight: 700; background: transparent; }
QLabel#approvalQuestion { color: @text@; background: transparent; }
QLabel#approvalDetail { color: @muted@; font-size: 11px; background: transparent; }
QPushButton#approve { background: @act@; color: @onAccent@; border: 0; padding: 8px; font-weight: 600; }
QPushButton#deny { background: transparent; color: @act@; border: 1px solid @act@; padding: 8px; font-weight: 600; }
QLabel#onlineChip {
    color: @wake@; font-family: "@mono@"; font-size: 11px; font-weight: 700;
    border: 1px solid @wake@; border-radius: 12px; padding: 4px 10px; margin-right: 8px;
}
QLabel#onlineChip[offline="true"] { color: @error@; border-color: @error@; }
QLabel#metaPill { color: @muted@; font-family: "@mono@"; font-size: 11px; padding: 0 8px; }
QLabel#drawerAgent { font-family: "@mono@"; font-weight: 700; background: transparent; }
QLabel#drawerState { font-family: "@mono@"; font-size: 11px; font-weight: 700; background: transparent; }
QLabel#drawerTitle { font-weight: 600; background: transparent; }

/* Hardcore mode: the switch is on (armed), the keyboard and mouse are locked or about to be, or it could not lock. */
QLabel#hardcoreBanner {
    padding: 8px 20px;
    font-weight: 600;
    border-bottom: 1px solid @line@;
    background: @panel2@;
    color: @text@;
}
QLabel#hardcoreBanner[level="locked"] { background: @errorSoft@; color: @text@; border-bottom: 1px solid @errorLine@; }
QLabel#hardcoreBanner[level="failed"] { background: @panel2@; color: @act@; border-bottom: 1px solid @act@; }

/* Nexa Phone: the PC is locked by hardcore mode (Unlock PC); the questions its tasks wait on reuse the approval card. */
QFrame#lockBar { background: @errorSoft@; border: 1px solid @errorLine@; border-radius: @radiusSmall@px; }
QLabel#lockText { color: @text@; font-weight: 600; background: transparent; }
QPushButton#unlockButton { background: @error@; color: @ground@; border: 0; padding: 8px 14px; font-weight: 700; }
QPushButton#unlockButton:disabled { background: @errorSoft2@; color: @muted@; }
