#!/usr/bin/env python3
"""Stands in for Claude Code (`claude`, Anthropic's coding agent CLI, 2.1.291) in Nexa's tests. Nothing here
touches a real account, a network or the owner's ~/.claude.

`claude --version` prints the version. `claude -p` plays print mode with --input-format stream-json: one JSON
line per turn on stdin (the Anthropic Messages shape, images as base64 blocks), NDJSON events on stdout the
way Claude Code 2.1.291 does (init, status, stream_event, assistant, rate_limit_event, result; init again on
every turn). What each turn answers comes from the JSON list in $FAKE_CLAUDE_SCRIPT, shared by every process of
a test (the position is kept beside it), so a restarted process carries on with the next entry:
  {"text": "..."}             the reply, streamed in two text deltas, then a result
  {"think": true, ...}        thinking deltas first (activity without text), "delay": seconds between them
  {"error": "...", "subtype": "error_during_execution", "status": 404}   a result with is_error (status: api_error_status)
  {"not-signed-in": true}     what the real one does signed out: an assistant event with error
                              "authentication_failed" and "Not logged in · Please run /login" as its text, a
                              result with subtype "success" and is_error true, then exit 1
  {"rate-limit": true}        an assistant event with error "rate_limit", a failed result (api_error_status 429)
  {"die": "..."}              that on stderr, and exit 1 before answering
  {"hang": true}              never answer
  {"garbage": true}           a line that is not JSON, then the reply
Each start ({"argv", "pid", "cwd", "pdeathsig", "env" = CLAUDECODE, CLAUDE_CODE_ENTRYPOINT and CLAUDE_CONFIG_DIR as
seen, "pathFirst" = the first PATH entry, "systemPrompt"}) and each turn ({"turn" = the text, "images" = their
media types and decoded sizes}) is appended to $FAKE_CLAUDE_LOG.

`claude auth status --json` answers from the file named by $FAKE_CLAUDE_AUTH: it holds the plan ("max") while
someone is signed in and is absent (or empty) while nobody is, so a sign-in in one process shows in the next.
Signed in, the JSON also carries an email and an organisation (which Nexa must never show); signed out it exits 1.
$FAKE_CLAUDE_STATUS = "garbage" prints a line that is not JSON; "die" prints nothing and exits 2.
`claude auth login [--claudeai]` prints "Opening browser to sign in…", the link line and "Paste code here if
prompted > " (no newline), then by $FAKE_CLAUDE_LOGIN:
  "code" (default)   reads a code from stdin: "bad" or nothing fails (exit 1), anything else signs in
                     ($FAKE_CLAUDE_PLAN, default "max") and exits 0; the code is logged as {"codeReceived"}
  "callback"         signs in by itself after $FAKE_CLAUDE_LOGIN_DELAY seconds (default 0.3) and exits 0
  "never"            waits
  "fail"             prints a failure naming the email, exits 1
  "nolink"           as "code", without the link line
`claude auth logout` removes the file and exits 0; $FAKE_CLAUDE_LOGOUT = "error" exits 1, "no-effect" exits 0
and keeps the sign-in. Every auth command is logged as {"auth": <command>}.
"""
import base64
import json
import os
import sys
import time

ALIASES = {"fable": "claude-fable-5-1", "opus": "claude-opus-4-1", "sonnet": "claude-sonnet-4-5",
           "haiku": "claude-haiku-4-5-20251001"}
EMAIL = "private.person@example.invalid"
LINK = "https://claude.example.invalid/oauth/authorize?code=true&state=SECRET-STATE"


def parent_death_signal():
    """The signal this process gets when its parent dies (prctl PR_GET_PDEATHSIG), or None."""
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        signal = ctypes.c_int(0)
        if libc.prctl(2, ctypes.byref(signal), 0, 0, 0) == 0:
            return signal.value
    except Exception:
        pass
    return None


def log(entry):
    path = os.environ.get("FAKE_CLAUDE_LOG")
    if path:
        with open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")


def next_entry():
    path = os.environ.get("FAKE_CLAUDE_SCRIPT")
    if not path:
        return {"text": "fake reply"}
    with open(path) as f:
        script = json.load(f)
    position_file = path + ".pos"
    position = int(open(position_file).read()) if os.path.exists(position_file) else 0
    with open(position_file, "w") as f:
        f.write(str(position + 1))
    return script[position] if position < len(script) else {"text": "fake reply"}


def out(text):
    sys.stdout.write(text)
    sys.stdout.flush()


def emit(event):
    out(json.dumps(event) + "\n")


def option(args, name):
    """The value after `name`, or None."""
    for i, arg in enumerate(args):
        if arg == name and i + 1 < len(args):
            return args[i + 1]
    return None


# ---- auth ------------------------------------------------------------------------------------------------

def auth_path():
    return os.environ.get("FAKE_CLAUDE_AUTH")


def plan():
    """The plan of whoever is signed in (the fake's auth file), or None."""
    path = auth_path()
    if not path or not os.path.exists(path):
        return None
    value = open(path).read().strip()
    return value or None


def sign_in():
    path = auth_path()
    if path:
        with open(path, "w") as f:
            f.write(os.environ.get("FAKE_CLAUDE_PLAN", "max"))


def auth_main(args):
    command = args[1] if len(args) > 1 else ""
    if command == "status":
        log({"auth": "status", "args": args[2:], "pid": os.getpid()})
        mode = os.environ.get("FAKE_CLAUDE_STATUS", "")
        if mode == "garbage":
            out("this is not json\n")
            return 0
        if mode == "die":
            sys.stderr.write("boom\n")
            return 2
        current = plan()
        if current:
            out(json.dumps({"loggedIn": True, "authMethod": "claude.ai", "apiProvider": "firstParty",
                            "analyticsDisabled": True, "subscriptionType": current, "email": EMAIL,
                            "orgName": "Private Org", "orgId": "org_SECRET"}, indent=2) + "\n")
            return 0
        out(json.dumps({"loggedIn": False, "authMethod": "none", "apiProvider": "firstParty",
                        "analyticsDisabled": True, "configDirectory": "/tmp/fake-claude"}, indent=2) + "\n")
        return 1
    if command == "login":
        mode = os.environ.get("FAKE_CLAUDE_LOGIN", "code")
        log({"auth": "login", "args": args[2:], "mode": mode, "pid": os.getpid()})
        out("Opening browser to sign in…\n")
        if mode != "nolink":
            out("If the browser didn't open, visit: %s\n" % LINK)
        if mode == "fail":
            out("Login failed for %s\n" % EMAIL)
            return 1
        out("Paste code here if prompted > ")
        if mode == "callback":
            time.sleep(float(os.environ.get("FAKE_CLAUDE_LOGIN_DELAY", "0.3")))
            sign_in()
            out("\nLogged in as %s\n" % EMAIL)
            return 0
        if mode == "never":
            time.sleep(120)
            return 1
        code = sys.stdin.readline().strip()
        log({"codeReceived": code})
        if not code or code == "bad":
            out("\nInvalid code\n")
            return 1
        sign_in()
        out("\nLogged in as %s\n" % EMAIL)
        return 0
    if command == "logout":
        mode = os.environ.get("FAKE_CLAUDE_LOGOUT", "ok")
        log({"auth": "logout", "mode": mode, "pid": os.getpid()})
        if mode == "error":
            sys.stderr.write("Could not log out\n")
            return 1
        path = auth_path()
        if mode != "no-effect" and path and os.path.exists(path):
            os.remove(path)
        out("Successfully logged out\n")
        return 0
    sys.stderr.write("unknown auth command\n")
    return 2


# ---- print mode ------------------------------------------------------------------------------------------

def init_event(model, session):
    return {"type": "system", "subtype": "init", "cwd": os.getcwd(), "session_id": session, "tools": [],
            "mcp_servers": [], "model": model, "permissionMode": "dontAsk", "slash_commands": [],
            "apiKeySource": "none", "claude_code_version": "2.1.291", "output_style": "default", "agents": [],
            "skills": [], "plugins": [], "uuid": "fake-init"}


def stream(session, event):
    emit({"type": "stream_event", "event": event, "session_id": session, "parent_tool_use_id": None, "uuid": "fake"})


def assistant(session, model, content, error=None):
    message = {"model": model, "id": "msg_fake", "type": "message", "role": "assistant", "content": content,
               "stop_reason": None, "stop_sequence": None, "usage": {"input_tokens": 1, "output_tokens": 1}}
    event = {"type": "assistant", "message": message, "parent_tool_use_id": None, "session_id": session,
             "uuid": "fake-assistant"}
    if error:
        event["error"] = error
    emit(event)


def result(session, text, turns, is_error=False, subtype="success", api_status=None, terminal="completed"):
    emit({"type": "result", "subtype": subtype, "is_error": is_error, "duration_ms": 10, "duration_api_ms": 9,
          "num_turns": turns, "result": text, "stop_reason": "end_turn" if not is_error else "stop_sequence",
          "session_id": session, "total_cost_usd": 0.0001, "usage": {"input_tokens": 1, "output_tokens": 1},
          "modelUsage": {}, "permission_denials": [], "terminal_reason": terminal, "api_error_status": api_status,
          "uuid": "fake-result"})


def print_main(args):
    log({"argv": args, "pid": os.getpid(), "cwd": os.getcwd(), "pdeathsig": parent_death_signal(),
         "env": {k: os.environ.get(k) for k in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CONFIG_DIR")},
         "pathFirst": os.environ.get("PATH", "").split(os.pathsep)[0], "systemPrompt": option(args, "--system-prompt")})
    alias = option(args, "--model")
    model = ALIASES.get(alias, alias) if alias else "claude-sonnet-4-5"
    session = "fake-session-%d" % os.getpid()
    turns = 0
    for line in sys.stdin:
        if not line.strip():
            continue
        message = json.loads(line)["message"]
        content = message.get("content", [])
        text = "".join(block.get("text", "") for block in content if block.get("type") == "text")
        images = [{"media_type": block["source"]["media_type"],
                   "bytes": len(base64.b64decode(block["source"]["data"]))}
                  for block in content if block.get("type") == "image"]
        log({"turn": text, "images": images, "role": message.get("role")})
        turns += 1
        entry = next_entry()
        emit(init_event(model, session))
        emit({"type": "system", "subtype": "status", "status": "requesting", "session_id": session, "uuid": "fake"})
        if "die" in entry:
            sys.stderr.write(entry["die"] + "\n")
            sys.stderr.flush()
            return 1
        if "hang" in entry:
            time.sleep(120)
            continue
        if entry.get("garbage"):
            out("this is not json\n")
        if entry.get("not-signed-in"):
            words = "Not logged in · Please run /login"
            assistant(session, "<synthetic>", [{"type": "text", "text": words}], error="authentication_failed")
            result(session, words, turns, is_error=True, terminal="api_error")
            return 1
        if entry.get("rate-limit"):
            words = "You've hit your limit · resets 3pm (Asia/Karachi)"
            assistant(session, "<synthetic>", [{"type": "text", "text": words}], error="rate_limit")
            result(session, words, turns, is_error=True, api_status=429, terminal="api_error")
            continue
        if "error" in entry:
            result(session, entry["error"], turns, is_error=True, subtype=entry.get("subtype", "error_during_execution"),
                   api_status=entry.get("status"), terminal="api_error")
            continue
        reply = entry.get("text", "fake reply")
        stream(session, {"type": "message_start", "message": {"model": model, "id": "msg_fake", "type": "message",
                                                               "role": "assistant", "content": [], "stop_reason": None,
                                                               "usage": {"input_tokens": 1, "output_tokens": 1}}})
        index = 0
        if entry.get("think"):
            delay = float(entry.get("delay", 0.05))
            stream(session, {"type": "content_block_start", "index": 0,
                             "content_block": {"type": "thinking", "thinking": "", "signature": ""}})
            for piece in ("Hmm", ", let me see", "."):
                stream(session, {"type": "content_block_delta", "index": 0,
                                 "delta": {"type": "thinking_delta", "thinking": piece}})
                time.sleep(delay)
            stream(session, {"type": "content_block_delta", "index": 0,
                             "delta": {"type": "signature_delta", "signature": "ZmFrZS1zaWduYXR1cmU="}})
            stream(session, {"type": "content_block_stop", "index": 0})
            index = 1
        stream(session, {"type": "content_block_start", "index": index, "content_block": {"type": "text", "text": ""}})
        half = len(reply) // 2
        stream(session, {"type": "content_block_delta", "index": index, "delta": {"type": "text_delta", "text": reply[:half]}})
        assistant(session, model, [{"type": "text", "text": reply[:half]}])
        stream(session, {"type": "content_block_delta", "index": index, "delta": {"type": "text_delta", "text": reply[half:]}})
        stream(session, {"type": "content_block_stop", "index": index})
        stream(session, {"type": "message_delta", "delta": {"stop_reason": "end_turn", "stop_sequence": None},
                         "usage": {"output_tokens": 2}})
        stream(session, {"type": "message_stop"})
        emit({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", "rateLimitType": "five_hour"},
              "uuid": "fake", "session_id": session})
        result(session, reply, turns)
    return 0


def main():
    args = sys.argv[1:]
    if args[:1] == ["--version"]:
        out("2.1.291 (Claude Code)\n")
        return 0
    if args[:1] == ["auth"]:
        return auth_main(args)
    if "-p" in args or "--print" in args:
        return print_main(args)
    sys.stderr.write("the fake claude knows --version, auth and -p\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
