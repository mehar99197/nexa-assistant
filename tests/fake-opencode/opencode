#!/usr/bin/env python3
"""Stands in for `opencode serve` (opencode 1.19.3's server API) in Nexa's tests.

`opencode serve --hostname H --port 0` binds a free port and prints the line opencode prints. Every
request needs basic auth as "opencode" with $OPENCODE_SERVER_PASSWORD. Routes: GET /global/health,
/config, /config/providers, /event (SSE); POST /session, /session/<id>/prompt_async,
/session/<id>/abort; DELETE /session/<id>. Each prompt plays the next entry of the JSON list in
$FAKE_OPENCODE_SCRIPT on the event stream:
  {"text": "...", "delay": s}        busy, (after s seconds, 0 if absent) the text in two deltas, idle
  {"reasoning": "...", "text": "..."}  the same, after a reasoning part streamed the way opencode does
  {"retry": "...", "reason": "..."}  busy, then a retry status (and nothing more)
  {"autherror": "..."}               busy, a ProviderAuthError, idle
  {"apierror": "...", "status": N}   busy, an APIError with that HTTP status (as opencode passes a provider's on), idle
  {"native": [{"name": .., "arguments": {..}}, ..], "then": "..."}
                                     the model calls tools natively that opencode does not have (as DeepSeek does when
                                     opencode's read tool is offered): each a tool part pending, running, error; then a
                                     step-finish and, unless the session was aborted, a second step answering "then"
It also has one MCP server ("fakemcp"), connected until POST /mcp/fakemcp/disconnect; GET /mcp answers
after $FAKE_OPENCODE_MCP_DELAY seconds (opencode waits for the servers to connect: 7 s measured). An
abort is reported the way opencode does, a MessageAbortedError 0.5 s later.
  {"hang": true}                     busy, and nothing more
Requests other than health and events go to $FAKE_OPENCODE_LOG as {"method", "path", "body"}; the
start goes there as {"pid", "argv", "cwd", "config"}.
"""
import base64
import json
import os
import queue
import re
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PASSWORD = os.environ.get("OPENCODE_SERVER_PASSWORD", "")
LOCK = threading.Lock()
LISTENERS = []
SESSIONS = [0]
ABORTED = set()
MCP = {"fakemcp": {"status": "connected"}}


def parent_death_signal():
    """The signal this process gets when its parent dies (prctl PR_GET_PDEATHSIG), or None."""
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        signal = ctypes.c_int(0)
        if libc.prctl(2, ctypes.byref(signal), 0, 0, 0) == 0:
            return signal.value
    except Exception:
        pass
    return None


def log(entry):
    path = os.environ.get("FAKE_OPENCODE_LOG")
    if path:
        with LOCK, open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")


def next_entry():
    path = os.environ.get("FAKE_OPENCODE_SCRIPT")
    if not path:
        return {"text": "fake reply"}
    with LOCK:
        script = json.load(open(path))
        position_file = path + ".pos"
        position = int(open(position_file).read()) if os.path.exists(position_file) else 0
        with open(position_file, "w") as f:
            f.write(str(position + 1))
    return script[position] if position < len(script) else {"text": "fake reply"}


def broadcast(event_type, **properties):
    event = {"type": event_type, "properties": properties}
    with LOCK:
        for listener in LISTENERS:
            listener.put(event)


def play(session, entry):
    time.sleep(0.05)
    broadcast("session.status", sessionID=session, status={"type": "busy"})
    if "retry" in entry:
        broadcast("session.status", sessionID=session,
                  status={"type": "retry", "attempt": 1, "message": entry["retry"],
                          "action": {"reason": entry.get("reason", "")}})
        return
    if "hang" in entry:
        return
    if "native" in entry:
        for i, called in enumerate(entry["native"]):
            part = {"id": "prt_t%d" % i, "messageID": "msg_1", "sessionID": session, "type": "tool",
                    "tool": called["name"], "callID": "call_%d" % i}
            for status in ("pending", "running", "error"):
                state = {"status": status, "input": called.get("arguments", {})}
                if status == "error":
                    state["error"] = "Model tried to call unavailable tool 'invalid'. Available tools: read"
                broadcast("message.part.updated", sessionID=session, part=dict(part, state=state))
        broadcast("message.part.updated", sessionID=session,
                  part={"id": "prt_sf", "messageID": "msg_1", "sessionID": session, "type": "step-finish"})
        time.sleep(0.3)
        if session in ABORTED:
            broadcast("session.status", sessionID=session, status={"type": "idle"})
            broadcast("session.idle", sessionID=session)
            return
        entry = {"text": entry.get("then", "I don't have that tool.")}
    if "autherror" in entry:
        broadcast("session.error", sessionID=session,
                  error={"name": "ProviderAuthError", "data": {"providerID": "fake", "message": entry["autherror"]}})
    elif "apierror" in entry:
        broadcast("session.error", sessionID=session,
                  error={"name": "APIError", "data": {"message": entry["apierror"], "statusCode": entry["status"],
                                                       "isRetryable": False}})
    else:
        # Like opencode, each part is announced (with its type) before its deltas, and every delta's
        # field is "text" — a reasoning part's included.
        if "reasoning" in entry:
            broadcast("message.part.updated", sessionID=session,
                      part={"id": "prt_r", "messageID": "msg_1", "sessionID": session, "type": "reasoning", "text": ""})
            broadcast("message.part.delta", sessionID=session, messageID="msg_1", partID="prt_r",
                      field="text", delta=entry["reasoning"])
        broadcast("message.part.updated", sessionID=session,
                  part={"id": "prt_1", "messageID": "msg_1", "sessionID": session, "type": "text", "text": ""})
        time.sleep(entry.get("delay", 0))
        text = entry["text"]
        half = len(text) // 2
        for piece in (text[:half], text[half:]):
            broadcast("message.part.delta", sessionID=session, messageID="msg_1", partID="prt_1",
                      field="text", delta=piece)
    broadcast("session.status", sessionID=session, status={"type": "idle"})
    broadcast("session.idle", sessionID=session)


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"

    def log_message(self, *args):
        pass

    def authorized(self):
        expected = "Basic " + base64.b64encode(("opencode:" + PASSWORD).encode()).decode()
        if self.headers.get("Authorization") == expected:
            return True
        self.reply(401, {"error": "unauthorized"})
        return False

    def reply(self, status, payload=None):
        body = b"" if payload is None else json.dumps(payload).encode()
        self.send_response(status)
        if payload is not None:
            self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def body(self):
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b""
        try:
            return json.loads(raw) if raw else None
        except ValueError:
            return raw.decode(errors="replace")

    def do_GET(self):
        if not self.authorized():
            return
        if self.path == "/global/health":
            return self.reply(200, {"healthy": True})
        if self.path == "/event":
            return self.events()
        log({"method": "GET", "path": self.path, "body": None})
        if self.path == "/mcp":
            time.sleep(float(os.environ.get("FAKE_OPENCODE_MCP_DELAY", "0")))
            return self.reply(200, MCP)
        if self.path == "/config":
            return self.reply(200, {"model": "fake/smart", "mcp": {"fakemcp": {"type": "local", "enabled": True}}})
        if self.path == "/config/providers":
            # Capabilities as opencode reports them: fast takes images, smart does not, one does not say.
            seeing = {"capabilities": {"toolcall": True, "input": {"text": True, "image": True}}}
            blind = {"capabilities": {"toolcall": True, "input": {"text": True, "image": False}}}
            return self.reply(200, {"providers": [{"id": "fake", "models": {"fast": seeing, "smart": blind}},
                                                  {"id": "other", "models": {"one": {}}}],
                                    "default": {"fake": "smart"}})
        self.reply(404, {"error": "no such route"})

    def events(self):
        listener = queue.Queue()
        with LOCK:
            LISTENERS.append(listener)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.end_headers()
        try:
            self.wfile.write(b'data: {"type":"server.connected","properties":{}}\n\n')
            self.wfile.flush()
            while True:
                try:
                    event = listener.get(timeout=1)
                except queue.Empty:
                    event = {"type": "server.heartbeat", "properties": {}}
                self.wfile.write(b"data: " + json.dumps(event).encode() + b"\n\n")
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            with LOCK:
                LISTENERS.remove(listener)

    def do_POST(self):
        if not self.authorized():
            return
        body = self.body()
        log({"method": "POST", "path": self.path, "body": body})
        if self.path == "/session":
            SESSIONS[0] += 1
            return self.reply(200, {"id": "ses_%d" % SESSIONS[0], "title": "Nexa"})
        prompt = re.fullmatch(r"/session/([^/]+)/prompt_async", self.path)
        if prompt:
            self.reply(204)
            threading.Thread(target=play, args=(prompt.group(1), next_entry()), daemon=True).start()
            return
        aborted = re.fullmatch(r"/session/([^/]+)/abort", self.path)
        if aborted:
            ABORTED.add(aborted.group(1))
            threading.Timer(0.5, broadcast, args=("session.error",),
                            kwargs={"sessionID": aborted.group(1),
                                    "error": {"name": "MessageAbortedError", "data": {"message": "Aborted"}}}).start()
            return self.reply(200, True)
        disconnect = re.fullmatch(r"/mcp/([^/]+)/disconnect", self.path)
        if disconnect:
            MCP[disconnect.group(1)] = {"status": "disabled"}
            return self.reply(200, True)
        self.reply(404, {"error": "no such route"})

    def do_DELETE(self):
        if not self.authorized():
            return
        log({"method": "DELETE", "path": self.path, "body": None})
        self.reply(200, True)


def main():
    args = sys.argv[1:]
    if not args or args[0] != "serve":
        return 2
    host = args[args.index("--hostname") + 1] if "--hostname" in args else "127.0.0.1"
    port = int(args[args.index("--port") + 1]) if "--port" in args else 0
    server = ThreadingHTTPServer((host, port), Handler)
    server.daemon_threads = True
    log({"pid": os.getpid(), "argv": args, "cwd": os.getcwd(), "config": os.environ.get("OPENCODE_CONFIG_CONTENT"),
         "pdeathsig": parent_death_signal()})
    print("opencode server listening on http://%s:%d" % (host, server.server_address[1]), flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
